{
  "name": "inference-chip-index",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Source-linked MLPerf Inference v6.0 comparisons of inference accelerators",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "pipeline:fixture": "bun run scripts/pipeline.ts --mode=fixture",
    "pipeline:full": "bun run scripts/pipeline.ts --mode=full-source",
    "pipeline:check": "bun run scripts/pipeline.ts --mode=full-source --check && bun run scripts/pipeline.ts --mode=fixture --check",
    "dataset:update": "bun run scripts/pipeline.ts --mode=full-source --promote",
    "dataset:rollback": "bun run scripts/rollback.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@lucid-agents/core": "5.0.0",
    "@lucid-agents/http": "4.0.0",
    "@lucid-agents/payments": "5.0.0",
    "@lucid-agents/types": "3.0.0",
    "@opennextjs/cloudflare": "1.14.8",
    "next": "16.0.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.16",
    "@types/node": "22.19.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.16",
    "typescript": "5.9.3",
    "wrangler": "4.45.3"
  }
}
